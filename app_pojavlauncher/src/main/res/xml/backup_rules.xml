<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Back up app preferences and settings -->
    <include domain="sharedpref" path="." />
    <!-- Back up internal app files (accounts, settings, control maps) -->
    <include domain="file" path="." />
    <!-- Exclude large cached/runtime data that can be re-downloaded -->
    <exclude domain="file" path="runtimes" />
    <exclude domain="cache" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
